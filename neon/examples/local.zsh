# Copy selected settings to ~/.config/neon/local.zsh (never tracked here).
# These are Zsh settings. Use local.bash for Bash-only changes.

# Personal style at work, if desired:
# export NEON_ARENA_QUIET=0

# Entirely disable the HUD/sounds while retaining other shell tools:
# export NEON_ARENA=0

# Keep regular Zsh history and your previous Ctrl-r binding:
# export NEON_ATUIN=0

# Keep your existing prompt instead of enabling Starship/the fallback prompt:
# export NEON_STARSHIP=0

# Plain Kickstart without the parent-owned Neovim overlay:
# export NEON_NVIM_OVERLAY=0

# Local-only command paths, with no duplicate PATH entries:
# _neon_path_prepend "$HOME/my-machine-tools/bin"

# Example alias override:
# alias ll='ls -alF'
